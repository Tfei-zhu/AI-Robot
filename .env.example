# ============ 大模型（OpenAI 兼容协议，三选一） ============
# 方式 A：阿里云 DashScope 通义千问（推荐，含 Embedding）
AIROBOT_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
AIROBOT_LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
AIROBOT_LLM_MODEL=qwen-plus

# 方式 B：DeepSeek（注意：DeepSeek 没有 Embedding 接口，向量模型请用 DashScope/Ollama）
# AIROBOT_LLM_BASE_URL=https://api.deepseek.com/v1
# AIROBOT_LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
# AIROBOT_LLM_MODEL=deepseek-chat

# 方式 C：本地 Ollama（离线可用）
# AIROBOT_LLM_BASE_URL=http://localhost:11434/v1
# AIROBOT_LLM_API_KEY=ollama
# AIROBOT_LLM_MODEL=qwen2.5:7b

# ============ Embedding 向量模型 ============
AIROBOT_EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
AIROBOT_EMBEDDING_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
AIROBOT_EMBEDDING_MODEL=text-embedding-v4
# Ollama 本地向量模型（离线）
# AIROBOT_EMBEDDING_BASE_URL=http://localhost:11434/v1
# AIROBOT_EMBEDDING_API_KEY=ollama
# AIROBOT_EMBEDDING_MODEL=nomic-embed-text

# ============ 智能体与 RAG ============
# 是否优先使用 CrewAI 多智能体（未安装 crewai 时自动降级为内置路由）
AIROBOT_USE_CREW=true
# 向量召回条数
AIROBOT_TOP_K=5
# 文档分块大小与重叠
AIROBOT_CHUNK_SIZE=400
AIROBOT_CHUNK_OVERLAP=80

# ============ 检索工程（混合检索 + 重排） ============
# 是否启用 向量+BM25 混合检索（RRF 融合）
AIROBOT_HYBRID_ENABLED=true
# 向量 / BM25 各自召回条数与 RRF 融合后候选条数
AIROBOT_HYBRID_VECTOR_TOP_K=15
AIROBOT_HYBRID_BM25_TOP_K=15
AIROBOT_HYBRID_FUSION_TOP_K=10
# 是否启用 bge-reranker 重排（首次调用会加载模型，约 10 秒）
AIROBOT_RERANK_ENABLED=true
AIROBOT_RERANK_MODEL=BAAI/bge-reranker-base

# ============ 向量库后端（默认内存，可切换 Milvus） ============
# inmemory：零依赖，进程内向量库（重启清空，启动时自动导入 data/ 示例知识）
# milvus  ：持久化 ANN 向量库，需先启动 Milvus 并安装 langchain-milvus：
#             docker compose -f docker-compose-milvus.yml up -d
#             pip install -r requirements-extra.txt（或 pip install langchain-milvus）
AIROBOT_VECTOR_STORE=inmemory
AIROBOT_MILVUS_URI=http://localhost:19530
# AIROBOT_MILVUS_TOKEN=   # Zilliz Cloud 等托管服务鉴权（本地部署留空）
AIROBOT_MILVUS_COLLECTION=airobot_kb
# 启动时清空 Milvus 集合再重建（与内存库"重启即初始"语义一致，避免重复导入；需要持久化时置 false）
AIROBOT_MILVUS_RESET_ON_START=true
# ============ 稳定性工程（重试 / 限流 / 语义缓存） ============
# LLM/Embedding 调用重试：最多尝试次数与最大退避秒数
AIROBOT_RETRY_ATTEMPTS=3
AIROBOT_RETRY_MAX_WAIT=8
# 接口限流（按 IP，60 秒窗口）
AIROBOT_RATELIMIT_ENABLED=true
AIROBOT_RATELIMIT_PER_MINUTE=30
# 语义缓存（首轮无上下文问题；双门限：余弦相似度 + 词面重叠率）
AIROBOT_CACHE_ENABLED=true
AIROBOT_CACHE_THRESHOLD=0.75
AIROBOT_CACHE_LEXICAL_THRESHOLD=0.5
AIROBOT_CACHE_MAX_ENTRIES=1000

# ============ 会话记忆 ============
# 每个会话最多保留的轮次数（超出裁剪最旧消息）
AIROBOT_MEMORY_MAX_TURNS=20
# 每次生成时带入上下文的最新轮次数
AIROBOT_MEMORY_RETRIEVE_TURNS=6

# ============ Docker Compose（第 5 批） ============
# 本地模式：docker compose up -d --build 默认走 compose 内置 ollama 服务
# （容器内 AIROBOT_LLM_BASE_URL=http://ollama:11434/v1，无需改上面地址），首次启动自动拉模型。
# 云端模式：把 docker-compose.yml 中 airobot 的 AIROBOT_LLM_BASE_URL / AIROBOT_EMBEDDING_BASE_URL
# 改为 https://dashscope.aliyuncs.com/compatible-mode/v1 并填 API Key，可同时删掉 ollama 服务。
