# ============ 大模型（OpenAI 兼容协议，三选一） ============
# 方式 A：阿里云 DashScope 通义千问（推荐，含 Embedding）
AIROBOT_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
AIROBOT_LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
AIROBOT_LLM_MODEL=qwen-plus

# 方式 B：DeepSeek（注意：DeepSeek 没有 Embedding 接口，向量模型请用 DashScope/Ollama）
# AIROBOT_LLM_BASE_URL=https://api.deepseek.com/v1
# AIROBOT_LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
# AIROBOT_LLM_MODEL=deepseek-chat

# 方式 C：本地 Ollama（离线可用）
# AIROBOT_LLM_BASE_URL=http://localhost:11434/v1
# AIROBOT_LLM_API_KEY=ollama
# AIROBOT_LLM_MODEL=qwen2.5:7b

# ============ Embedding 向量模型 ============
AIROBOT_EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
AIROBOT_EMBEDDING_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
AIROBOT_EMBEDDING_MODEL=text-embedding-v4
# Ollama 本地向量模型（离线）
# AIROBOT_EMBEDDING_BASE_URL=http://localhost:11434/v1
# AIROBOT_EMBEDDING_API_KEY=ollama
# AIROBOT_EMBEDDING_MODEL=nomic-embed-text

# ============ LangGraph Agent 与 RAG ============
# 单次 Agent Run 最多进行的工具调用轮次，避免模型异常循环
AIROBOT_AGENT_MAX_TOOL_ROUNDS=4
# S1 定义配置；主图选择在 S3 接入前仍使用原 Go 流程。
# 只影响 Go 任务，不开启普通聊天自动委派；不依赖 CONTEXT_MODE 开关。
AIROBOT_GO_MULTI_AGENT_ENABLED=false
# 留空继承 AIROBOT_LLM_MODEL；两个角色可分别指定，使用现有模型端点和凭据。
AIROBOT_GO_MULTI_AGENT_SUPERVISOR_MODEL=
AIROBOT_GO_MULTI_AGENT_CODE_MODEL=
AIROBOT_GO_MULTI_AGENT_MAX_REPAIRS=2
AIROBOT_GO_MULTI_AGENT_MAX_NORMAL_CALLS=7
# 全任务共享异常重试，包含于总调用数，不能给每个角色分别加额度。
AIROBOT_GO_MULTI_AGENT_MAX_RETRIES=1
AIROBOT_GO_MULTI_AGENT_MAX_MODEL_CALLS=8
AIROBOT_GO_MULTI_AGENT_MAX_VALIDATIONS=3
AIROBOT_GO_MULTI_AGENT_MAX_RETRIEVALS=1
AIROBOT_GO_MULTI_AGENT_TASK_TIMEOUT=360
AIROBOT_GO_MULTI_AGENT_CODE_TIMEOUT=120
AIROBOT_GO_MULTI_AGENT_SUPERVISOR_TIMEOUT=60
AIROBOT_GO_MULTI_AGENT_VALIDATION_TIMEOUT=90
AIROBOT_GO_MULTI_AGENT_CLEANUP_TIMEOUT=15
# 启用前必须填真实模型窗口；0 表示未知，enabled=true 时启动拒绝。
# 与实验性上下文管理独立；词表未校准时不能声称精确 Token 硬上限。
AIROBOT_GO_MULTI_AGENT_SUPERVISOR_WINDOW=0
AIROBOT_GO_MULTI_AGENT_CODE_WINDOW=0
AIROBOT_GO_MULTI_AGENT_SUPERVISOR_INPUT_TOKENS=16000
AIROBOT_GO_MULTI_AGENT_CODE_INPUT_TOKENS=16000
AIROBOT_GO_MULTI_AGENT_SUPERVISOR_OUTPUT_TOKENS=4096
AIROBOT_GO_MULTI_AGENT_CODE_OUTPUT_TOKENS=8192
AIROBOT_GO_MULTI_AGENT_SAFETY_TOKENS=2048
# 向量召回条数
AIROBOT_TOP_K=5
# 文档分块大小与重叠
AIROBOT_CHUNK_SIZE=400
AIROBOT_CHUNK_OVERLAP=80

# ============ 检索工程（混合检索 + 重排） ============
# 是否启用 向量+BM25 混合检索（RRF 融合）
AIROBOT_HYBRID_ENABLED=true
# 向量 / BM25 各自召回条数与 RRF 融合后候选条数
AIROBOT_HYBRID_VECTOR_TOP_K=15
AIROBOT_HYBRID_BM25_TOP_K=15
AIROBOT_HYBRID_FUSION_TOP_K=10
# 是否启用 bge-reranker 重排（首次调用会加载模型，约 10 秒）
AIROBOT_RERANK_ENABLED=true
AIROBOT_RERANK_MODEL=BAAI/bge-reranker-base

# ============ 向量库后端（默认内存，可切换 Milvus） ============
# inmemory：零依赖，向量索引重启重建；文章正文从 SQLite 状态库重放
# milvus  ：持久化 ANN 向量库，需先启动 Milvus 并安装 langchain-milvus：
#             docker compose -f docker-compose-milvus.yml up -d
#             pip install -r requirements-extra.txt（或 pip install langchain-milvus）
AIROBOT_VECTOR_STORE=inmemory
AIROBOT_MILVUS_URI=http://localhost:19530
# AIROBOT_MILVUS_TOKEN=   # Zilliz Cloud 等托管服务鉴权（本地部署留空）
AIROBOT_MILVUS_COLLECTION=airobot_kb
# 启动不再清库；旧 RESET_ON_START 配置已废弃且不会生效
# 旧 auto_id=true 集合请保留备份并改用新集合名重建
AIROBOT_KNOWLEDGE_STATE_DB=data/knowledge.sqlite3
AIROBOT_ADMIN_TOKEN=
# ============ 稳定性工程（重试 / 限流 / 语义缓存） ============
# LLM/Embedding 调用重试：最多尝试次数与最大退避秒数
AIROBOT_RETRY_ATTEMPTS=3
AIROBOT_RETRY_MAX_WAIT=8
# 接口限流（按 IP，60 秒窗口）
AIROBOT_RATELIMIT_ENABLED=true
AIROBOT_RATELIMIT_PER_MINUTE=30
# 语义缓存（首轮无上下文问题；双门限：余弦相似度 + 词面重叠率）
# 命中范围按账户隔离，且只在知识库版本未变时生效（改写提问才有收益）
# 词面阈值是唯一的松紧旋钮：调高（如 0.7）更保守，调低更激进
AIROBOT_CACHE_ENABLED=true
AIROBOT_CACHE_THRESHOLD=0.75
AIROBOT_CACHE_LEXICAL_THRESHOLD=0.5
AIROBOT_CACHE_MAX_ENTRIES=1000

# ============ 会话记忆 ============
# 每个会话最多保留的轮次数（超出裁剪最旧消息）
AIROBOT_MEMORY_MAX_TURNS=20
# 每次生成时带入上下文的最新轮次数
AIROBOT_MEMORY_RETRIEVE_TURNS=6

# ============ Go 文章服务集成（article 工具真实数据 + 文章自动入库） ============
# Go 网关地址（文章社区后端）；留空 = 集成未启用，article 工具返回降级文案
AIROBOT_GO_API_BASE_URL=http://localhost:8080
# 调用 Go /internal/ai 私有接口的内部令牌（需与 Go 侧 AI_INTERNAL_TOKEN 一致）
AIROBOT_GO_INTERNAL_TOKEN=dev-internal-token
# 校验 Go 网关透传身份头（X-Account-Id）所需的令牌（需与 Go 侧 AI_INTERNAL_TOKEN 一致；
# 配置后网关代理流量按账号限流而非按 IP）
AIROBOT_AI_INTERNAL_TOKEN=dev-internal-token
# 调 Go 内部接口超时（秒）
AIROBOT_GO_API_TIMEOUT=5
# RabbitMQ 连接（文章发布事件订阅）；留空 = 不启动入库消费者
# AIROBOT_AMQP_URL=amqp://admin:password123@localhost:5672/
# 订阅拓扑：与 Go 侧 DeclareTopic 保持一致（durable topic 交换机 + durable 队列）
AIROBOT_AMQP_EXCHANGE=article.timeline.events
AIROBOT_AMQP_QUEUE=article.ai.ingest.queue
AIROBOT_AMQP_ROUTING_KEY=article.timeline.publish
AIROBOT_AMQP_PREFETCH=5
# 可恢复失败的重投策略：最多重投次数与指数退避（2s、4s、8s、16s…封顶 30s）
# 超过上限后不再重投，登记到 ingest_failures 表并计入 /health 的 ingest_failed_events
AIROBOT_AMQP_MAX_RETRIES=5
AIROBOT_AMQP_RETRY_BACKOFF_SECONDS=2
AIROBOT_AMQP_RETRY_MAX_BACKOFF_SECONDS=30
# SQLite 持久化文章正文、入库状态与去重记录（随 data 目录保存）
AIROBOT_INGEST_STATE_DB=data/airobot_state.sqlite3
# 手动上传单文件大小上限（字节，默认 10 MiB）
AIROBOT_MAX_UPLOAD_BYTES=10485760
# 非上传类 JSON 接口的请求体上限（字节，默认 256 KiB），解析前拦截
AIROBOT_MAX_REQUEST_BYTES=262144

# ============ Docker Compose（第 5 批） ============
# 本地模式：docker compose up -d --build 默认走 compose 内置 ollama 服务
# （容器内 AIROBOT_LLM_BASE_URL=http://ollama:11434/v1，无需改上面地址），首次启动自动拉模型。
# 云端模式：把 docker-compose.yml 中 airobot 的 AIROBOT_LLM_BASE_URL / AIROBOT_EMBEDDING_BASE_URL
# 改为 https://dashscope.aliyuncs.com/compatible-mode/v1 并填 API Key，可同时删掉 ollama 服务。

# ============ 上下文管理（默认关闭，通过质量验收后再启用） ============
AIROBOT_CONTEXT_MODE=off
# 强制模式必须核对模型窗口，并运行 scripts/calibrate_context_counter.py。
AIROBOT_CONTEXT_MODEL_WINDOW=0
AIROBOT_CONTEXT_CALIBRATION_PATH=
AIROBOT_CONTEXT_ENCODING=cl100k_base
AIROBOT_CONTEXT_INPUT_LIMIT=16000
AIROBOT_CONTEXT_OUTPUT_TOKENS=4096
AIROBOT_CONTEXT_SAFETY_TOKENS=2048
AIROBOT_CONTEXT_HISTORY_TOKENS=6000
AIROBOT_CONTEXT_SUMMARY_TOKENS=1000
AIROBOT_CONTEXT_EVIDENCE_TOKENS=4000
AIROBOT_CONTEXT_TOOL_TOKENS=1500
AIROBOT_CONTEXT_READ_TOKENS=1000
AIROBOT_CONTEXT_HISTORY_ENABLED=true
AIROBOT_CONTEXT_SUMMARY_ENABLED=true
AIROBOT_CONTEXT_EVIDENCE_TTL=600
AIROBOT_CONTEXT_SUMMARY_TIMEOUT=30
AIROBOT_CONTEXT_SUMMARY_TRIGGER_RATIO=0.9
AIROBOT_CONTEXT_SUMMARY_TARGET_RATIO=0.7
AIROBOT_CONTEXT_STORE_PATH=data/context.sqlite3
AIROBOT_CONTEXT_STRATEGY_VERSION=context-v1
# 仅在模型、地域和调用方式匹配时指定单价文件；示例单价有核对日期。
AIROBOT_CONTEXT_PRICE_BOOK=
